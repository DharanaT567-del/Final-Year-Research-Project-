spring.application.name=apigateway
server.port=8080

# ── AI Tutor (Spring AI + Gemini + Pinecone) ──────────────────
spring.ai.openai.api-key=${AI_API_KEY:${GEMINI_API_KEY:your_gemini_api_key}}
spring.ai.openai.base-url=${AI_BASE_URL:https://generativelanguage.googleapis.com/v1beta/openai}
spring.ai.openai.chat.options.model=gemini-2.5-flash
spring.ai.openai.chat.options.temperature=0.3
spring.ai.openai.embedding.options.model=gemini-embedding-001

spring.ai.vectorstore.pinecone.api-key=${PINECONE_API_KEY:your_pinecone_api_key}
spring.ai.vectorstore.pinecone.environment=${PINECONE_ENVIRONMENT:us-east-1}
spring.ai.vectorstore.pinecone.index-name=${PINECONE_INDEX_NAME:naada-music-index}
spring.ai.vectorstore.pinecone.namespace=${PINECONE_NAMESPACE:_default_}
