# Naada RAG Vector Ingestion Configuration
# Copy this file to .env and provide your API keys if not using environment variables or application.properties

GEMINI_API_KEY=your_gemini_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=naada-music-index
PINECONE_ENVIRONMENT=us-east-1
PINECONE_NAMESPACE=_default_
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072
BATCH_SIZE=25
BATCH_DELAY_SECONDS=1.5
